# ============================================
# ODOD PIZZA — .gitignore
# ============================================

# 1. Секреты и ключи (ОЧЕНЬ ВАЖНО!)
.env
*.env

# 2. База данных SQLite
*.db
*.sqlite
*.sqlite3

# 3. Кэш Python
__pycache__/
*.py[cod]
*$py.class

# 4. Файлы операционной системы
.DS_Store
Thumbs.db
desktop.ini

# 5. Настройки редакторов
.vscode/
.idea/
*.swp
*.swo

# 6. Логи и временные файлы
*.log
error_log
